        "model": "cobblesafari:block/hyperspace_planter_base"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "cobblesafari:block/hyperspace_planter_side_north"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "cobblesafari:block/hyperspace_planter_side_east"
      }
    },
    {
